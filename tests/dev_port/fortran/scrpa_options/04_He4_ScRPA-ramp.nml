! dev-port test case 'scrpa_options' (tests/dev_port/julia/scrpa_options.jl): 4He HF_ScRPA TBCF_alpha = 1, TBCF_beta = 2, OBDM_alpha = 0.8, RPA_Orb, Exact
! Run the files of this directory in order from one work directory (see ../../run_fortran.sh)
