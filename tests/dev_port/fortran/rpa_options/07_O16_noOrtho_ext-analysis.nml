! dev-port test case 'rpa_options': analysis of the non-EJ multipole 2- (Cut 0.05) of TDA-noOrtho & RPA-noOrtho
! Run the files of this directory in order from one work directory: nujuliet 01_*.nml 02_*.nml ... (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'O16'
/
&tda
  Name = 'TDA-noOrtho', Ortho = .false.
/
&rpa
  Name = 'RPA-noOrtho', Ortho = .false.
/
&run
  Solvers = 'TDA_transition_analysis', 'RPA_transition_analysis'
/
&transition_analysis
  JP = '2-', nu_list = 1, 2, Cut = 0.05
/
