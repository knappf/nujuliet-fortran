! dev-port test case 'rpa_options': TDA/RPA-noOrtho 2+ densities (D2), TDA 0+ operator densities, 2+ currents M = 1 (20 x 30)
! Run the files of this directory in order from one work directory: nujuliet 01_*.nml 02_*.nml ... (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'O16'
/
&tda
  Name = 'TDA-noOrtho', Ortho = .false.
/
&rpa
  Name = 'RPA-noOrtho', Ortho = .false.
/
&run
  Solvers = 'TDA_transition_densities', 'RPA_transition_densities', 'TDA_transition_operator_densities', 'TDA_transition_currents', 'RPA_transition_currents'
/
&transition_densities
  JP = '2+', nu_list = 1, 3, File_Name = 'D2'
/
&transition_operator_densities
  JP = '0+', nu_list = 1, 2
/
&transition_currents
  JP = '2+', M = 1, nu_list = 1, 2, xN_grid = 20, zN_grid = 30
/
