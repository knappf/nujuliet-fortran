! dev-port test case 'o16_open' (tests/dev_port/julia/o16_open.jl): 20O TDA-frac / RPA-frac with Tol_par = 0.9, Tol_hol = 0.5 + 2+ transition densities nu = 1, 2
! Run the files of this directory in order from one work directory (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 20, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'O20'
/
&hf
  ESH = .false.
/
&tda
  Name = 'TDA-frac', Tol_par = 0.9, Tol_hol = 0.5
/
&rpa
  Name = 'RPA-frac', Tol_par = 0.9, Tol_hol = 0.5
/
&run
  Solvers = 'TDA', 'RPA', 'TDA_transition_densities', 'RPA_transition_densities'
/
&transition_densities
  JP = '2+', nu_list = 1, 2, File_Name = 'Phonon_Densities'
/
