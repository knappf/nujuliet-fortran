! dev-port test case 'qp_options' (tests/dev_port/julia/qp_options.jl): 22Ne HFB -> QTDA (Ortho = false) -> pnQTDA (QRPA stops in both codes: complex eigenvectors)
! Run the files of this directory in order from one work directory (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 22, Z = 10, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'Ne22_HFB'
/
&qtda
  Ortho = .false., Reference = 'HFB'
/
&pnqtda
  Reference = 'HFB'
/
&run
  Solvers = 'HFB', 'QTDA', 'pnQTDA'
/
