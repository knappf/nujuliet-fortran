! dev-port test case 'bundled' (tests/dev_port/julia/bundled.jl): V2b_parse / V3b_no2b_parse of the bundled interaction to Nmax 2 / N2max 4 / N3max 6 (io/parse must exist)
! Run the files of this directory in order from one work directory: nujuliet 01_*.nml 02_*.nml ... (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
/
&parse
  N_max_Out = 2, N_2max_Out = 4, N_3max_Out = 6
  NN_Out_File = 'io/parse/NN_parsed.bin', NNN_Out_File = 'io/parse/NNN_parsed.bin'
/
&run
  Solvers = 'V2b_parse', 'V3b_no2b_parse'
/
