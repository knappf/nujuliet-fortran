! dev-port test case 'bundled' (tests/dev_port/julia/bundled.jl): 16O HF -> TDA -> RPA + transition densities/currents/operator densities/analysis of both
! Run the files of this directory in order from one work directory: nujuliet 01_*.nml 02_*.nml ... (see ../../run_fortran.sh)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'O16'
/
&run
  Solvers = 'HF', 'TDA', 'RPA', 'RPA_transition_densities', 'TDA_transition_densities', 'TDA_transition_currents', 'RPA_transition_currents', 'TDA_transition_operator_densities', 'RPA_transition_operator_densities', 'TDA_transition_analysis', 'RPA_transition_analysis'
/
&transition_densities
  JP = '1-', nu_list = 5, 6, 7, File_Name = 'Phonon_Densities'
/
&transition_currents
  JP = '1-', M = 0, nu_list = 5, 6, 7, File_Name = 'Phonon_Currents', xN_grid = 40, zN_grid = 40
/
&transition_operator_densities
  JP = '1-', nu_list = 5, 6, 7, File_Name = 'Phonon_Transition_Operator_Densities'
/
&transition_analysis
  JP = '1-', nu_list = 5, 6, 7, File_Name = 'Phonon_Transtion_Analysis', Cut = 0.1
/
