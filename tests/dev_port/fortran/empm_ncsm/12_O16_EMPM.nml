! empm_ncsm dev-form input (dev HF -> EMPM/NCSM reading io/<Path>/<Reference>/bin/*); legacy twin in ../empm_ncsm_legacy
! 16O 4 shells: full-space EMPM_TDA (Ortho), 2PH with E2max = 60, channels 0+ 1- 2+;
! explicit &empm Reference = 'HF'; dev TDA for the full-space EMPM_TDA == TDA check
! Run all files of this directory in order from one work directory (see ../../run_empm_ncsm.sh dev)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
  CMS = 'CMS1+2B'
  Path = 'O16'
/
&hf
  Tol = 1e-10
/
&empm
  Reference = 'HF'
  E2max = 60.0, JP2 = '0+', '1-', '2+'
/
&run
  Solvers = 'TDA', 'EMPM_TDA', 'EMPM_2PH'
/
