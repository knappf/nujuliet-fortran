! EXPECT: Error! ... EMPM_TDA did not run, the 2-phonon step of EMPM is skipped
! MKDIR: io/O16/EMPM/bin
! empm_ncsm error path (dev form, run alone in a fresh io/ by ../../../run_empm_ncsm.sh dev): combined 'EMPM' action with
! a stale io/O16/EMPM/bin and no reference io/O16/HF: EMPM_TDA prints the error and skips, then the 2-phonon step of
! 'EMPM' is not run (exit 0)
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 2, N2max = 4, N3max = 6
  CMS = 'CMS1+2B'
  Path = 'O16'
/

&run
  Solvers = 'EMPM'
/
