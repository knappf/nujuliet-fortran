  A = 16, Z = 8, hw = 16.0, Nmax = 2, N2max = 4, N3max = 6
  CMS = 'CMS1+2B'
  Path = 'O16'
/
&empm
  Reference = 'HF/bin'
/
&run
  Solvers = 'EMPM_TDA'
/
