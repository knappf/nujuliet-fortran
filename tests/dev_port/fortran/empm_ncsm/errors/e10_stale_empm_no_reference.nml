! EXPECT: Error! ... No precomputed reference ''io/O16/HF'' is available
! MKDIR: io/O16/EMPM/bin
! empm_ncsm error path (dev form, run alone in a fresh io/ by ../../../run_empm_ncsm.sh dev): io/O16/EMPM/bin is left
! over from an earlier run but the reference io/O16/HF is missing: EMPM_2PH checks the reference first, prints the error
! and skips (exit 0) instead of reading the stale EMPM binaries
&interaction
  NN_File  = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NN.bin'
  NNN_File = '/scratch/local.ssd/knapp/job_25503048.pbs-m1/NuJuliet_dev_ref/io/NNN.bin'
  hw = 16.0, Nmax = 3, N2max = 6, N3max = 9
/
&calculation
  A = 16, Z = 8, hw = 16.0, Nmax = 2, N2max = 4, N3max = 6
  CMS = 'CMS1+2B'
  Path = 'O16'
/

&run
  Solvers = 'EMPM_2PH'
/
